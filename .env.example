# ============================================================
# 2mails.pro — Environment configuration
# ============================================================
# Copy this file to .env for local development.
# On Coolify, set these as environment variables in the dashboard.
# ============================================================

# ---- Database (SQLite) ----
# Local development:
DATABASE_URL="file:/home/z/2mails-pro/db/twomails.db"
# Production (Docker/Coolify) — points to the mounted volume:
# DATABASE_URL="file:/app/data/twomails.db"

# ---- Admin user (created on first run by seed script) ----
ADMIN_EMAIL="admin@2mails.pro"
ADMIN_PASSWORD="changeme-in-production"
ADMIN_NAME="2mails.pro Admin"

# ---- Session secret (used to sign session cookies) ----
# Generate with: openssl rand -hex 32
SESSION_SECRET="change-this-to-a-random-secret"

# ---- Server ----
NODE_ENV="production"
PORT=3000
HOSTNAME=0.0.0.0
